#!/usr/bin/env bash
# =============================================================================
#  pg_health_check.conf.example — 巡检配置样例
#
#  用法：复制为 ~/.pg_health_check.conf，只填「节点清单 + 账号」两项，
#        然后执行 ./pg_health_check.sh 即可完成整组主从的巡检。
#
#  优先级：命令行(--set) > 环境变量 > 本文件 > 内置默认值
# =============================================================================

# =============================================================================
#  一、主从节点清单（只需要改这里）
# =============================================================================

# 主库地址
PRIMARY_HOST="10.0.0.11"
PRIMARY_PORT="5432"                 # 主库端口；备库未单独写端口时也默认用它

# 备库清单：可写多行，也可用空格/逗号分隔
#   支持三种写法： 10.0.0.12   |   10.0.0.12:5433   |   pg2=10.0.0.12:5432（别名便于看报告）
#   以 # 开头的内容会被忽略
STANDBY_HOSTS="
10.0.0.12
10.0.0.13
# 10.0.0.14:5433
# pg4=10.0.0.15:5432
"

# 说明：
#   * 只填 PRIMARY_HOST 不填 STANDBY_HOSTS 时，会按“1 主 0 备”巡检并告警无备库连接
#   * 两个都不填、只用命令行 -h 时，脚本退化为“单节点巡检”，不做角色约束
#   * 想跳过某个节点，直接在对应行前面加 # 即可

# =============================================================================
#  二、连接账号（所有节点共用；不同节点密码不同请用 ~/.pgpass）
# =============================================================================
PGUSER="monitor"                    # 建议授予 pg_monitor 角色，只读即可
PGDATABASE="postgres"
# PGPASSWORD="xxxxxx"               # 不推荐写明文，优先 ~/.pgpass（权限 600）
PGCONNECT_TIMEOUT="5"               # 连接超时（秒）

# 单节点模式专用（不填上面的集群清单、又不带 -h 时生效，一般留空）
PGHOST=""
PGPORT=""

# 角色：集群模式下用于约束主库角色（auto=按配置判定）
PGHC_ROLE="auto"                    # auto | primary | standby

# =============================================================================
#  三、巡检阈值（可按机房/规格调整，全部为“越大越差”）
# =============================================================================

# --- 磁盘 / inode 使用率(%) ---
DISK_WARN="80"
DISK_CRIT="90"
INODE_WARN="80"
INODE_CRIT="90"
EXTRA_DISK_PATHS=""                 # 额外巡检路径，空格分隔，如 "/data/pg_wal /backup"

# --- CPU / 内存 ---
CPU_WARN="85"                       # /proc/stat 采样忙时占比告警线(%)
CPU_CRIT="95"
LOAD_WARN_PER_CORE="1.5"            # 1 分钟负载 / CPU 核数
LOAD_CRIT_PER_CORE="3.0"
CPU_SAMPLE="1"                      # CPU 采样秒数，0=只报负载不采样
MEM_WARN="85"                       # 内存使用率告警线(%)
MEM_CRIT="95"
SWAP_WARN="60"
SWAP_CRIT="90"

# --- 连接数 ---
CONN_WARN="80"                      # 已用连接 / (max_connections - superuser_reserved)
CONN_CRIT="90"
IDLE_IN_XACT_WARN="10"              # idle in transaction 连接数告警线(达到即 WARN)

# --- 主备延迟 ---
REPL_SECS_WARN="30"                 # 时间延迟告警线(秒)
REPL_SECS_CRIT="300"
REPL_BYTES_WARN="16777216"          # 字节延迟告警线(16MB)
REPL_BYTES_CRIT="268435456"         # 字节延迟严重线(256MB)
REPL_MIN_STANDBYS="1"               # 主库最少应连接的备库数量
REPL_NO_STANDBY_LEVEL="CRIT"        # 不满足上述数量时的级别: OK|WARN|CRIT

# --- 集群一致性核对 ---
REPL_EXPECT_CONFIGURED="1"          # 1=核对本文件里配置的每个备库是否都已连上主库
REPL_MISSING_STANDBY_LEVEL="WARN"   # 有备库掉线时的级别（NAT 场景可设 WARN 或关闭核对）

# =============================================================================
#  四、其它
# =============================================================================
PGHC_TIMEOUT="15"                   # 单个节点单条 psql 命令超时(秒)
COLOR="1"                           # 1=彩色(仅 TTY)，0=纯文本
